{
  "name": "quill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "tsx apps/api/src/server.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "seed": "tsx apps/api/src/db/seed.ts",
    "record": "tsx apps/api/src/replay/record.ts",
    "eval": "tsx scripts/run-eval.ts",
    "gen:audio": "tsx scripts/gen-audio.ts",
    "gen:attendance": "python3 scripts/gen-attendance.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "^0.24.0",
    "@sentry/node": "^8.0.0",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^6.8.0",
    "multer": "^1.4.5-lts.1",
    "tsx": "^4.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
